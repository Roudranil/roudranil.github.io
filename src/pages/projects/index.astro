---
import "@styles/base.css";
import { SITE } from "@config";
import Header from "@components/Header.astro";
import ContentListing from "@components/ContentListing.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { buildListRows, groupRowsByYear } from "@utils/listing";

const projects = await getCollection("projects", ({ data }) => {
    return data.draft !== true;
});
const groups = groupRowsByYear(buildListRows(projects, "/projects"));
---

<!--
    This file is used to generate the index page for the projects section
-->
<BaseLayout title={`Projects | ${SITE.title}`}>
    <Header activeNav="projects" />
    <Breadcrumbs />
    <main>
        <section id="projects" class="mx-auto max-w-3xl px-4">
            <h1 class="page-title">Projects</h1>
            <ContentListing groups={groups} />
        </section>
    </main>
</BaseLayout>
