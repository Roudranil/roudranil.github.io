---
import "@styles/base.css";
import { SITE } from "@config";
import Header from "@components/Header.astro";
import ContentListing from "@components/ContentListing.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { buildListRows, groupRowsByYear } from "@utils/listing";

const posts = await getCollection("posts", ({ data }) => {
    return data.draft !== true;
});
const groups = groupRowsByYear(buildListRows(posts, "/posts"));
---

<!--
    This file is used to generate the index page for the posts section
-->
<BaseLayout title={`Posts | ${SITE.title}`}>
    <Header activeNav="posts" />
    <Breadcrumbs />
    <main>
        <section id="posts" class="mx-auto max-w-3xl px-4">
            <h1 class="page-title">Posts</h1>
            <ContentListing groups={groups} />
        </section>
    </main>
</BaseLayout>
