---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import TextLink from "@components/TextLink.astro";
import { SITE } from "@config";

import "@styles/base.css";

const structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE.title,
    url: SITE.website,
    description: SITE.desc,
};
---

<BaseLayout>
    <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
        slot="structured-data"
    />
    <Header activeNav="~" />
    <div class="title-div">
        <h1 class="text-ctp-rosewater">Hello everyone &#x1F44B</h1>
    </div>
    <br />
    <p>
        I am Roudranil, and I am currently working as a Machine Learning Scientist in the <b>Advertising AI</b> team at <b>Expedia Group</b>.
    </p>
    <br />
    <p>
        I like to dabble in the math behind ML, engineering philosphies, linux, gaming and whatever piques my interest at any given point of time. Feel free to look at <TextLink href="/about">~/about</TextLink> to know more
        about me.
    </p>
    <br />
</BaseLayout>

<style>
    @reference "@styles/base.css";
    .title-div {
        @apply inline-block content-center pt-20 text-center text-2xl font-bold sm:text-3xl;
    }

    p {
        @apply mx-auto my-2 max-w-2xl text-center text-base;
    }
</style>
