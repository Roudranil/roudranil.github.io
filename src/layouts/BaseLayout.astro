---
import { SITE } from "@config";
import "@styles/base.css";
import Footer from "@components/Footer.astro";
import { ClientRouter } from "astro:transitions";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
    title?: string;
    author?: string;
    description?: string;
    canonicalURL?: string;
}

const {
    title = SITE.title,
    author = SITE.author,
    description = SITE.desc,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <!-- Some metadata regarding the font encoding, favicon, viewport and generator -->
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/icon.svg" />
        <link rel="canonical" href={canonicalURL} />
        <meta name="generator" content={Astro.generator} />

        <!-- Meta tags for SEO -->
        <!-- Actual title -->
        <title>{title}</title>
        <!-- SEO stuff -->
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content={author} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <!-- Pre load backup google fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <!-- <link
            href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap"
            rel="stylesheet"
        /> -->
        <!-- KaTeX (self-hosted, see docs/build-and-deploy.md) -->
        <link rel="stylesheet" href="/styles/katex.min.css" />
        <link rel="stylesheet" href="/styles/katex-custom.css" />

        <!-- Other stylesheets to apply after compiling -->
        <link rel="stylesheet" href="/styles/loadfonts.css" />
        <link rel="stylesheet" href="/styles/remark-styles.css" />
        <link rel="stylesheet" href="/styles/miscellaneous-styles.css" />

        {
            // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
            // include google-site-verification tag in the heading
            // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
            googleSiteVerification && (
                <meta
                    name="google-site-verification"
                    content={googleSiteVerification}
                />
            )
        }

        <!-- Enabling google analytics -->
        <!-- Google tag (gtag.js) -->
        <script
            type="text/partytown"
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-REHV5RW6LZ"
        ></script>
        <script type="text/partytown">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-REHV5RW6LZ");
        </script>

        <ClientRouter />
    </head>
    <body>
        <slot />
        <button onclick="topFunction()" id="scrolltotop" title="Scroll to Top"
            >^</button
        >
        <Footer />
        <style>
    @reference "@styles/base.css";
            #scrolltotop {
                @apply fixed bottom-5 right-7 z-[99] hidden h-16 cursor-pointer rounded-2xl border border-none bg-ctp-surface1 p-2 text-xl text-ctp-red opacity-75 outline-hidden transition duration-200 hover:bg-ctp-surface0 hover:text-ctp-sapphire sm:text-4xl;
            }
        </style>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // Get the button:
                let mybutton: HTMLElement =
                    document.getElementById("scrolltotop")!;

                // When the user scrolls down 20px from the top of the document, show the button
                window.onscroll = function () {
                    scrollFunction();
                };

                function scrollFunction() {
                    if (
                        document.body.scrollTop > 20 ||
                        document.documentElement.scrollTop > 20
                    ) {
                        mybutton.style.display = "block";
                    } else {
                        mybutton.style.display = "none";
                    }
                }

                // When the user clicks on the button, scroll to the top of the document
                mybutton.onclick = function () {
                    topFunction();
                };

                function topFunction() {
                    const currentScroll =
                        document.documentElement.scrollTop ||
                        document.body.scrollTop;

                    if (currentScroll > 0) {
                        // Smoothly scroll to the top
                        window.requestAnimationFrame(topFunction);
                        window.scrollTo(0, currentScroll - currentScroll / 8);
                    }
                }
            });
        </script>
    </body>
</html>
