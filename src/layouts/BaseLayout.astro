---
import { SITE } from "@config";
import "@styles/base.css";
import Footer from "@components/Footer.astro";
import { ClientRouter } from "astro:transitions";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
    title?: string;
    author?: string;
    description?: string;
    canonicalURL?: string;
    image?: string;
    type?: "website" | "article";
    publishedTime?: Date;
    modifiedTime?: Date | null;
    seo_keywords?: string[];
}

const {
    title = SITE.title,
    author = SITE.author,
    description = SITE.desc,
    canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
    image = "/og-image.png",
    type = "website",
    publishedTime,
    modifiedTime,
    seo_keywords,
} = Astro.props;

const ogImageURL = new URL(image, Astro.site).href;
---

<!doctype html>
<html lang="en">
    <head>
        <!-- Some metadata regarding the font encoding, favicon, viewport and generator -->
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/icon.svg" />
        <link rel="canonical" href={canonicalURL} />
        <meta name="generator" content={Astro.generator} />

        <!-- Meta tags for SEO -->
        <!-- Actual title -->
        <title>{title}</title>
        <!-- SEO stuff -->
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content={author} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title={SITE.title}
            href="/rss.xml"
        />

        <!-- Open Graph -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:site_name" content={SITE.title} />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

        {
            // article-specific open graph tags; only meaningful when type="article" (post pages)
            type === "article" && publishedTime && (
                <meta
                    property="article:published_time"
                    content={publishedTime.toISOString()}
                />
            )
        }
        {
            type === "article" &&
                modifiedTime &&
                modifiedTime.toISOString() !== publishedTime?.toISOString() && (
                    <meta
                        property="article:modified_time"
                        content={modifiedTime.toISOString()}
                    />
                )
        }
        {
            type === "article" &&
                seo_keywords ?.map((tag) => <meta property="article:tag" content={tag} />)
        }

        <slot name="structured-data" />
        <!-- Pre load backup google fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <!-- <link
            href="https://fonts.googleapis.com/css2?family=Raleway:ital,wght@0,400;0,500;0,600;0,700;1,400;1,700&display=swap"
            rel="stylesheet"
        /> -->
        <!-- KaTeX (self-hosted, see docs/build-and-deploy.md) -->
        <link rel="stylesheet" href="/styles/katex.min.css" />
        <link rel="stylesheet" href="/styles/katex-custom.css" />

        <!-- Other stylesheets to apply after compiling -->
        <link rel="stylesheet" href="/styles/loadfonts.css" />
        <link rel="stylesheet" href="/styles/miscellaneous-styles.css" />

        {
            // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
            // include google-site-verification tag in the heading
            // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
            googleSiteVerification && (
                <meta
                    name="google-site-verification"
                    content={googleSiteVerification}
                />
            )
        }

        <!-- Enabling google analytics -->
        <!-- Google tag (gtag.js) -->
        <script
            type="text/partytown"
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-REHV5RW6LZ"
        ></script>
        <script type="text/partytown">
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag("js", new Date());

            gtag("config", "G-REHV5RW6LZ");
        </script>

        <ClientRouter />
    </head>
    <body>
        <!-- <div id="scrolltotop-wrap">
            <button id="scrolltotop" title="Scroll to Top"
                ><span class="font-mono">󰁝</span></button
            >
        </div> -->
        <slot />
        <Footer />
        <!-- <style>
    @reference "@styles/base.css";
            #scrolltotop-wrap {
                position: sticky;
                top: 0;
                height: 0;
            }
            #scrolltotop {
                @apply absolute z-99 h-12 w-12 flex items-center justify-center hidden leading-none cursor-pointer rounded-full border border-none bg-ctp-surface1 text-lg text-ctp-red opacity-75 outline-hidden transition duration-200 hover:bg-ctp-surface0 hover:text-ctp-sapphire;
                top: calc(100vh - 4rem);
                top: calc(100dvh - 4rem);
                right: calc(1rem - var(--body-right-inset, 0px));
            }
        </style> -->

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                // Get the button:
                let mybutton: HTMLElement =
                    document.getElementById("scrolltotop")!;

                // body is mx-auto and narrower than the viewport on wide
                // screens, so its right edge isn't the viewport's right edge —
                // measure the gap so the button can sit at the true screen edge.
                function setEdgeInset() {
                    const rect = document.body.getBoundingClientRect();
                    document.documentElement.style.setProperty(
                        "--body-right-inset",
                        `${window.innerWidth - rect.right}px`,
                    );
                }
                setEdgeInset();
                window.addEventListener("resize", setEdgeInset);

                // When the user scrolls down 20px from the top of the document, show the button
                window.onscroll = function () {
                    scrollFunction();
                };

                function scrollFunction() {
                    if (
                        document.body.scrollTop > 20 ||
                        document.documentElement.scrollTop > 20
                    ) {
                        mybutton.style.display = "flex";
                    } else {
                        mybutton.style.display = "none";
                    }
                }

                // When the user clicks on the button, scroll to the top of the document.
                // Native smooth scroll (not a manual rAF loop) so the browser
                // cancels it automatically if the user scrolls during the animation.
                mybutton.onclick = function () {
                    window.scrollTo({ top: 0, behavior: "smooth" });
                };
            });
        </script>
    </body>
</html>
