---
interface Props {
    githubURL: string;
}

const { githubURL } = Astro.props;

function getRepoLabel(url: string): string {
    try {
        const segments = new URL(url).pathname.split("/").filter(Boolean);
        return segments.length >= 2 ? `${segments[0]}/${segments[1]}` : "Github";
    } catch {
        return "Github";
    }
}

const repoLabel = getRepoLabel(githubURL);
---

<div class="github-div">
    <a href={githubURL} title={githubURL} class="not-prose">  &nbsp;{repoLabel}</a>
</div>

<style>
    @reference "@styles/base.css";
    .github-div {
        @apply w-fit text-ctp-lavender text-base transition duration-100 hover:text-dark-sapphire;
    }
</style>
