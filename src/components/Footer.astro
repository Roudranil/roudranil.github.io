---
import Socials from "./Socials.astro";
---

<footer class="mt-auto">
    <div class="footer-wrapper">
        <Socials centered />
        <span class="powered-by">Powered by <a href="https://astro.build/">Astro</a></span>
    </div>
</footer>

<style>
    @reference "@styles/base.css";
    footer {
        @apply w-full;
    }

    .footer-wrapper {
        @apply mt-[128px] flex flex-col items-center justify-between py-6 sm:flex-row-reverse sm:py-4;
    }

    .powered-by {
        @apply my-2 text-xs text-ctp-peach;
    }
</style>
