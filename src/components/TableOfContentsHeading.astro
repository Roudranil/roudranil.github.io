---
// TableOfContentsHeading.astro
import TextLink from "./TextLink.astro";
import type { TOCNode } from "@utils";
import "@styles/base.css";

export interface Props {
    heading: TOCNode;
}

const { heading } = Astro.props;
---

<li>
    <span
        class="select-none font-mono text-ctp-overlay1"
        aria-hidden="true"
    >
        {heading.prefix}{heading.connector}
    </span>
    <TextLink
        href={"#" + heading.slug}
        className="text-sm"
        color="text-ctp-overlay1"
    >
        {heading.text}
    </TextLink>
    {
        heading.subheadings.length > 0 && (
            <ul class="my-0 list-none pl-0">
                {heading.subheadings.map((subheading) => (
                    <Astro.self heading={subheading} />
                ))}
            </ul>
        )
    }
</li>

<style>
    @reference "@styles/base.css";
    ul,
    li {
        margin: 0;
        padding: 0;
        list-style-type: none;
    }

    li {
        word-wrap: break-word;
        line-height: 1.25;
    }

    span[aria-hidden] {
        white-space: pre;
    }
</style>
