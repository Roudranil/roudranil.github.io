---
import "@styles/base.css";

export interface Props {
    type: "info" | "alert" | "tip" | "normal";
    title?: string;
}
const { type, title } = Astro.props;

const titles = {
    info: {
        symbol: "",
        text: "Information",
        border: "border-ctp-frappe-sky",
        accent: "border-t-ctp-sky",
        titleColor: "text-ctp-sky",
    },
    alert: {
        symbol: "",
        text: "Warning",
        border: "border-ctp-frappe-red",
        accent: "border-t-ctp-red",
        titleColor: "text-ctp-red",
    },
    tip: {
        symbol: "󱐌",
        text: "Tip",
        border: "border-ctp-frappe-green",
        accent: "border-t-ctp-green",
        titleColor: "text-ctp-green",
    },
    normal: {
        symbol: "󰎚",
        text: "Note",
        border: "border-ctp-frappe-overlay2",
        accent: "border-t-ctp-overlay2",
        titleColor: "text-ctp-overlay2",
    },
} as Record<
    string,
    {
        symbol: string;
        text: string;
        border: string;
        accent: string;
        titleColor: string;
    }
>;
---

<div
    id="Block"
    class=`${titles[type].border} ${titles[type].accent} relative my-8 rounded-xl border border-t-8 bg-transparent`
>
    <p class=`block-title ${titles[type].titleColor}`>
        <span class="inline-block w-6 text-center font-mono">{titles[type].symbol}</span>
        <span class="font-bold">{title ?? titles[type].text}</span>
    </p>
    <div class=`text ${titles[type].titleColor}`>
        <slot />
    </div>
</div>

<style>
    @reference "@styles/base.css";
    .block-title {
        @apply absolute -top-5 left-4 m-0 bg-ctp-base px-2 text-lg;
    }

    .text {
        @apply m-0 p-4 pt-6;
    }

    .text > :global(:first-child) {
        margin-top: 0;
    }

    .text > :global(:last-child) {
        margin-bottom: 0;
    }

    .text :global(.expressive-code) {
        @apply mb-4 text-ctp-text;
    }
</style>
